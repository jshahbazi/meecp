diff --git a/crates/uzu-engine/src/backends/cpu/kernel/gdn/conv_direct.rs b/crates/uzu-engine/src/backends/cpu/kernel/gdn/conv_direct.rs
new file mode 100644
--- /dev/null
+++ b/crates/uzu-engine/src/backends/cpu/kernel/gdn/conv_direct.rs
@@ -0,0 +1,62 @@
+use half::bf16;
+use num_traits::Float;
+use uzu_engine_macros::kernel;
+
+use crate::{array::ArrayElement, backends::common::gpu_types::ActivationType};
+
+// CPU reference for the direct scan. Match Conv1dPack + DeltaNetConvScan,
+// including retained history when the suffix is shorter than the state.
+#[kernel(DeltaNetConvDirect)]
+#[variants(T, f32, bf16)]
+pub fn delta_net_conv_direct<T: ArrayElement + Float>(
+    input: *const T,
+    state_in: *const f32,
+    conv_weight: *const f32,
+    #[optional(has_bias)] bias: Option<*const f32>,
+    output: *mut T,
+    state_out: *mut f32,
+    suffix_len: u32,
+    kernel_size: u32,
+    row_stride: u32,
+    state_stride: u32,
+    conv_dim: u32,
+    #[specialize] has_bias: bool,
+) {
+    let suffix_len = suffix_len as usize;
+    let kernel_size = kernel_size as usize;
+    let row_stride = row_stride as usize;
+    let state_stride = state_stride as usize;
+    let conv_dim = conv_dim as usize;
+    for token in 0..suffix_len {
+        for channel in 0..row_stride {
+            if channel >= conv_dim {
+                unsafe { *output.add(token * row_stride + channel) = *input.add(token * row_stride + channel) };
+                continue;
+            }
+            let mut acc = if has_bias { unsafe { *bias.unwrap().add(channel) } } else { 0.0f32 };
+            for tap in 0..kernel_size {
+                let padded_row = token + tap;
+                let sample = if padded_row < state_stride {
+                    unsafe { *state_in.add(channel * state_stride + padded_row) }
+                } else {
+                    unsafe { (*input.add((padded_row - state_stride) * row_stride + channel)).to_f32().unwrap() }
+                };
+                acc += unsafe { *conv_weight.add(channel * kernel_size + tap) } * sample;
+            }
+            unsafe {
+                *output.add(token * row_stride + channel) = T::from(ActivationType::SILU.activate(acc)).unwrap();
+            }
+        }
+    }
+    for channel in 0..conv_dim {
+        for tap in 0..state_stride {
+            let padded_row = suffix_len + tap;
+            let sample = if padded_row < state_stride {
+                unsafe { *state_in.add(channel * state_stride + padded_row) }
+            } else {
+                unsafe { (*input.add((padded_row - state_stride) * row_stride + channel)).to_f32().unwrap() }
+            };
+            unsafe { *state_out.add(channel * state_stride + tap) = sample };
+        }
+    }
+}
diff --git a/crates/uzu-engine/src/backends/metal/kernel/gdn/conv_direct.metal b/crates/uzu-engine/src/backends/metal/kernel/gdn/conv_direct.metal
new file mode 100644
--- /dev/null
+++ b/crates/uzu-engine/src/backends/metal/kernel/gdn/conv_direct.metal
@@ -0,0 +1,52 @@
+#include <metal_stdlib>
+#include "../activation/activations.h"
+#include "../common/dsl.h"
+
+using namespace metal;
+
+// The original projection and history snapshot are immutable and disjoint from
+// the output projection and next state. Preserve the packed scan's tap order,
+// F32 accumulation, SiLU, and final cast without materializing F32 token rows.
+template <typename T>
+VARIANTS(T, float, bfloat)
+PUBLIC KERNEL(DeltaNetConvDirect)(
+    device const T* input,
+    device const float* state_in,
+    device const float* conv_weight,
+    device const float* bias OPTIONAL(has_bias),
+    device T* output,
+    device float* state_out,
+    constant const uint& suffix_len,
+    constant const uint& kernel_size,
+    constant const uint& row_stride,
+    constant const uint& state_stride,
+    constant const uint& conv_dim,
+    const bool has_bias SPECIALIZE,
+    const uint token_idx AXIS(suffix_len + kernel_size - 1, 1),
+    const uint channel_idx AXIS(row_stride, 32)
+) {
+  if (token_idx < suffix_len) {
+    const size_t dst = size_t(token_idx) * row_stride + channel_idx;
+    if (channel_idx >= conv_dim) {
+      output[dst] = input[dst];
+      return;
+    }
+    const device float* weight_row = conv_weight + channel_idx * kernel_size;
+    float acc = has_bias ? float(bias[channel_idx]) : 0.0f;
+    for (uint tap = 0; tap < kernel_size; ++tap) {
+      const uint padded_row = token_idx + tap;
+      const float sample = padded_row < state_stride
+          ? state_in[channel_idx * state_stride + padded_row]
+          : float(input[(padded_row - state_stride) * row_stride + channel_idx]);
+      acc += float(weight_row[tap]) * sample;
+    }
+    output[dst] = static_cast<T>(activate_silu(acc));
+  } else if (channel_idx < conv_dim) {
+    const uint tap = token_idx - suffix_len;
+    // Small suffixes can retain history samples in their next state.
+    const float sample = token_idx < state_stride
+        ? state_in[channel_idx * state_stride + token_idx]
+        : float(input[(token_idx - state_stride) * row_stride + channel_idx]);
+    state_out[channel_idx * state_stride + tap] = sample;
+  }
+}

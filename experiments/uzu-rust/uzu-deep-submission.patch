+    #[uzu_test]
+    fn submission_drain_waits_every_buffer_after_failures() {
+        let mut pending = vec![0, 1, 2, 3];
+        let mut visited = Vec::new();
+        let result = drain_submissions(&mut pending, |index| {
+            visited.push(index);
+            if index == 1 || index == 2 {
+                Err(index)
+            } else {
+                Ok(())
+            }
+        });
